{
  "cyclops-prism": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/hook.py --event PreInvocation",
        "timeout": 3
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/hook.py --event PostInvocation",
        "timeout": 3
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook.py --event PreToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook.py --event PostToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/hook.py --event Stop",
        "timeout": 3
      }
    ]
  }
}
